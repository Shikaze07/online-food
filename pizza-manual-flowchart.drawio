<mxfile host="app.diagrams.net"><diagram name="Current Manual Process"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" pageWidth="900" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s" value="Start" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#99e6dc;strokeColor=#333;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="20" width="180" height="50" as="geometry"/></mxCell><mxCell id="a1" value="Customer calls or visits the pizza shop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="240" height="60" as="geometry"/></mxCell><mxCell id="a2" value="Customer orders pizza verbally (by phone or at the counter)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="270" y="200" width="260" height="70" as="geometry"/></mxCell><mxCell id="a3" value="Staff writes the order and customer details on paper" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="270" y="300" width="260" height="70" as="geometry"/></mxCell><mxCell id="a4" value="Staff hands the paper ticket to the kitchen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="400" width="240" height="60" as="geometry"/></mxCell><mxCell id="a5" value="Kitchen prepares the pizza" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="490" width="240" height="60" as="geometry"/></mxCell><mxCell id="d" value="Delivery or pickup?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#5b86c4;strokeColor=#333;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="580" width="240" height="110" as="geometry"/></mxCell><mxCell id="b1" value="Sta