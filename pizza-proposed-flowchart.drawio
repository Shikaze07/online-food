<mxfile host="app.diagrams.net"><diagram name="Proposed System Flowchart"><mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" pageWidth="950" pageHeight="1650"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;FLOWCHART OF THE PROPOSED SYSTEM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; font-weight: normal; color: #555555;&quot;&gt;Online Pizza Ordering &amp;amp; Delivery Management System&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="225" y="20" width="500" height="45" as="geometry"/></mxCell><mxCell id="s" value="Start" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#99e6dc;strokeColor=#333;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="385" y="85" width="180" height="50" as="geometry"/></mxCell><mxCell id="p1" value="Customer accesses Web / Mobile platform and logs in or registers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="165" width="270" height="65" as="geometry"/></mxCell><mxCell id="p2" value="Customer browses pizza menu, selects items, and adds to cart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="260" width="270" height="65" as="geometry"/></mxCell><mxCell id="p3" value="Customer proceeds to checkout &amp; selects order type (Delivery or Pick-up)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="355" width="270" height="65" as="geometry"/></mxCell><mxCell id="p4" value="Customer selects payment method
(Online Payment / E-Wallet or Cash on Delivery / Counter)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="450" width="270" height="65" as="geometry"/></mxCell><mxCell id="p5" value="System verifies payment &amp; generates digital order ticket with order ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="545" width="270" height="65" as="geometry"/></mxCell><mxCell id="p6" value="Kitchen receives order notification on Kitchen Dashboard &amp; prepares pizza" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="640" width="270" height="65" as="geometry"/></mxCell><mxCell id="d" value="Delivery or pickup?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#5b86c4;strokeColor=#333;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="355" y="735" width="240" height="105" as="geometry"/></mxCell><mxCell id="del1" value="Admin / System assigns available delivery rider to the order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="880" width="270" height="65" as="geometry"/></mxCell><mxCell id="del2" value="Rider receives delivery notification, customer details, &amp; GPS route on Rider App" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="975" width="270" height="70" as="geometry"/></mxCell><mxCell id="del3" value="Rider picks up pizza and updates status to &quot;Out for Delivery&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="1075" width="270" height="65" as="geometry"/></mxCell><mxCell id="del4" value="Customer tracks delivery status in real-time on Web / Mobile App" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="1170" width="270" height="65" as="geometry"/></mxCell><mxCell id="del5" value="Rider delivers pizza, collects payment (if COD), and marks order as &quot;Delivered&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="1265" width="270" height="70" as="geometry"/></mxCell><mxCell id="del6" value="System logs completed delivery and updates customer order history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="1365" width="270" height="65" as="geometry"/></mxCell><mxCell id="de" value="Completed" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#99e6dc;strokeColor=#333;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="1460" width="180" height="50" as="geometry"/></mxCell><mxCell id="pic1" value="Kitchen updates status to &quot;Ready for Pick-up&quot; in the system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="625" y="880" width="270" height="65" as="geometry"/></mxCell><mxCell id="pic2" value="System automatically notifies customer that order is ready for collection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="625" y="975" width="270" height="65" as="geometry"/></mxCell><mxCell id="pic3" value="Customer arrives at store counter and presents digital order ID / receipt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="625" y="1070" width="270" height="65" as="geometry"/></mxCell><mxCell id="pic4" value="Customer collects pizza (pays at counter if Pay-on-Pickup)" style="rounded=1;